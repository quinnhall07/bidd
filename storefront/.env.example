# Storefront environment. Copy to .env.local and fill in. The NEXT_PUBLIC_* values are public, never secrets;
# GOOGLE_GENERATIVE_AI_API_KEY is a secret and is only read on the server.
#
# Leave NEXT_PUBLIC_BIDD_API_URL unset (or empty) to run on mock data: no email is sent and any 6-digit code works.
# Set it to turn on live mode: real sign-in codes, onboarding, listings, orders and the Cup from Rouan's API
# (handoff/BACKEND_BRIEF.md). If a live call fails, the storefront quietly falls back to mock data.

# Bidd API base URL, no trailing slash. The backend runs on port 3000 locally (cd backend && npm run dev).
NEXT_PUBLIC_BIDD_API_URL=http://localhost:3000

# Cloudflare Turnstile site key (bot check on "Send code"). Same value as the backend's .env.local; ask Rouan.
# CAPTCHA is on in Supabase, so request-code fails with captcha_failed without it. Leave empty to hide the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# IMPORTANT: the API only accepts browser requests from origins in the backend's FRONTEND_ORIGINS
# (default http://localhost:3001). Since the API takes port 3000, run the storefront on 3001:
#   cd storefront && npx next dev -p 3001
# If you use another port or host, add that origin to FRONTEND_ORIGINS in backend/.env.local.

# Google AI Studio key (https://aistudio.google.com/apikey) for "Fill with AI" on /sell: app/api/ai-listing sends the
# photo to Gemma 4 (gemma-4-26b-a4b-it) on the Gemini API. SECRET: server-only, never prefix it with NEXT_PUBLIC_.
# Leave empty and the route answers 503 ai_unavailable; the sell flow then uses its on-device demo fill.
# On Vercel set it in Project Settings > Environment Variables (Production), then redeploy.
GOOGLE_GENERATIVE_AI_API_KEY=
